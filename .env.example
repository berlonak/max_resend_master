# ── Telegram ─────────────────────────────────────────────
TG_BOT_TOKEN=123456:AA...
TG_CHAT_ID=-1001234567890
# Локальный Bot API Server снимает лимиты 20/50 МБ (до 2000 МБ на отправку).
TG_LOCAL_BOT_API=false
TG_API_BASE=https://api.telegram.org

# ── MAX ──────────────────────────────────────────────────
# Токен из расширенных настроек бота в кабинете разработчика MAX.
MAX_BOT_TOKEN=your_max_bot_token
MAX_CHAT_ID=123456789
# Обязателен с 19.07.2026. Старый platform-api.max.ru использовать нельзя.
MAX_BASE_URL=https://platform-api2.max.ru

# ── Хранилище и поведение ────────────────────────────────
DB_PATH=bridge.db
MEDIA_DIR=media
ALBUM_DEBOUNCE=1.5
BRIDGE_TIMEZONE=Europe/Moscow

# ── TLS ──────────────────────────────────────────────────
# MAX работает на сертификатах НУЦ Минцифры. Мост доверяет системному
# хранилищу, набору certifi и всему, что лежит в папке certs/.
# Здесь можно указать дополнительный файл или папку с корневыми сертификатами.
MAX_CA_BUNDLE=
# Отключать проверку TLS можно ТОЛЬКО для отладки — трафик станет уязвим.
SSL_VERIFY=true

# Уровень логирования: INFO по умолчанию, DEBUG показывает сырые события MAX.
LOG_LEVEL=INFO
